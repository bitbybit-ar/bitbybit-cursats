# ===========================================
# BitByBit Cursats — Environment Variables
# ===========================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local

# Public — App base URL — REQUIRED
# Used for canonical URLs, sitemap, robots.txt, Open Graph, JSON-LD.
# No trailing slash. Throws at boot if unset.
# Production: https://cursats.bitbybit.com.ar
# Local:      http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Database — Neon Postgres — REQUIRED
# Use the appropriate Neon branch for each environment:
#   - Production: main branch
#   - Preview:    dev branch
#   - CI tests:   test branch (configured separately in .env.test)
DATABASE_URL=postgresql://user@localhost:5432/bitbybit_cursa

# Auth — JWT signing secret — REQUIRED in production
# Signs the session cookie used for login (ADR 0007). In dev/test a
# deterministic fallback is used so the suite and `npm run dev` work
# without any env setup.
# Generate one with:  openssl rand -base64 32
AUTH_SECRET=change-this-to-a-random-string

# Wapu — Lightning <-> ARS rail — REQUIRED for checkout
# Two-leg, poll-driven flow (no webhooks): a Lightning deposit credits
# our USDT wallet, then a fiat withdrawal settles ARS to the seller's
# CBU/alias. Docs: https://docs.wapupay.com/api-docs
# Auth header is X-API-Key. Get the key from POST /users/api-token after
# authenticating with email + password against POST /users/login.
#
# WAPU_PAY_APU_HOST is the API base URL (differs per environment):
#   Staging:    https://be-stage.wapu.app
#   Production: https://be-prod.wapu.app
# Both are required: getWapuClient() throws if either is missing. There
# is no mock fallback, so a misconfigured deploy fails loud rather than
# silently faking payments.
WAPU_API_KEY=
WAPU_PAY_APU_HOST=

# Cron — secures the Wapu settlement job — REQUIRED in production
# Vercel Cron sends `Authorization: Bearer ${CRON_SECRET}` to
# /api/cron/wapu-settlements (schedule in vercel.json). The route
# refuses requests without a matching secret. Use a high-entropy value.
CRON_SECRET=

# Exchange rate — the sats<->ARS rate shown across the storefront is
# derived from Wapu's /exchange_rates (buy USDT/ARS × buy BTC/USD), so
# it uses WAPU_PAY_APU_HOST + WAPU_API_KEY above. No separate env var.
# Decision in ADR 0027 (superseding the Yadio source of ADR 0022).

# Blossom — image upload destination for /panel/ofertas — REQUIRED
# for the upload UI to work
# Comma-separated list of Blossom server base URLs (no trailing slash).
# The merchant signs a kind:24242 event with their Nostr key and the
# image is PUT to every server in parallel; the row stores the URL of
# the first to ACK. ADR 0011.
# Defaults below are stable, free public servers; change to
# self-hosted if you want sovereignty.
NEXT_PUBLIC_BLOSSOM_SERVERS=https://blossom.primal.net,https://cdn.satellite.earth

# Public — Lightning address for the landing-page "Zap the devs" modal
# OPTIONAL. user@domain format (LNURL-pay). When unset the modal
# surfaces an "address not configured" error so we don't silently
# point zaps at someone else's wallet. Falls back to the legacy
# NEXT_PUBLIC_LIGHTNING_ADDRESS for backward compatibility.
NEXT_PUBLIC_ZAP_LIGHTNING_ADDRESS=
