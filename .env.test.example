# ===========================================
# BitByBit Cursats — Test Environment
# ===========================================
# Copy to .env.test (gitignored) and fill in for integration tests:
#   cp .env.test.example .env.test
#
# Integration tests under tests/integration/ load this file and
# require a real Postgres connection (Neon test branch recommended).
# Tests truncate every table on each run, so DO NOT point this at a
# database that contains real data.

DATABASE_URL=postgresql://user@localhost:5432/bitbybit_cursa_test
AUTH_SECRET=test-secret-deterministic-for-CI
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Optional owner pubkey for `npm run db:seed` against the test DB.
# `npub1…` or 64-char hex; unset → the all-zeros demo user. See the
# fuller note in .env.example.
SEED_PUBKEY=

# Optional — enables the gated NWC live smoke test (ADR 0029) in
# tests/integration/lib/nwc-staging.test.ts. A **receive-only**
# `nostr+walletconnect://` connection (no pay_invoice permission). The
# test mints a 1-sat invoice and never pays it. Leave unset and the
# test skips, so CI (which never sets this) stays green.
NWC_TEST_URI=
